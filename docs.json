{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lemonyde",
  "description": "Lemonyde is a community-made bootstrapper for Sober — the VinegarHQ Flatpak that runs Roblox on Linux. Install, update, launch, edit FastFlags, and customize Sober from one native GTK4 + libadwaita app.",
  "colors": {
    "primary": "#EAB308",
    "light": "#FDE047",
    "dark": "#A16207"
  },
  "logo": {
    "light": "https://raw.githubusercontent.com/EpicNeco/Lemonyde/main/assets/lemonyde-title.svg",
    "dark": "https://raw.githubusercontent.com/EpicNeco/Lemonyde/main/assets/lemonydetitlealt.svg"
  },
  "favicon": "https://raw.githubusercontent.com/EpicNeco/Lemonyde/main/assets/lemonyde.svg",
  "fonts": {
    "family": "Work Sans"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/EpicNeco/Lemonyde"
      },
      {
        "type": "discord",
        "href": "https://dc.gg/lemonyde"
      },
      {
        "label": "Website",
        "href": "https://lemonyde.netlify.app"
      },
      {
        "label": "Sober",
        "href": "https://sober.vinegarhq.org"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Lemonyde",
      "href": "https://github.com/EpicNeco/Lemonyde/releases/latest"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "installation",
          "quickstart"
        ]
      },
      {
        "group": "Core Features",
        "pages": [
          "features/home-dashboard",
          "features/multi-instance",
          "features/fflag-editor",
          "features/customize",
          "features/wrapper-settings",
          "features/advanced-tools"
        ]
      },
      {
        "group": "Understanding Sober",
        "pages": [
          "concepts/file-locations",
          "concepts/first-run-wizard",
          "concepts/fflag-allowlist",
          "concepts/build-from-source"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "troubleshooting",
          "faq",
          "disclaimer"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/EpicNeco/Lemonyde"
        },
        {
          "anchor": "Discord",
          "icon": "discord",
          "href": "https://dc.gg/lemonyde"
        },
        {
          "anchor": "Report an Issue",
          "icon": "bug",
          "href": "https://github.com/EpicNeco/Lemonyde/issues"
        },
        {
          "anchor": "Sober Docs",
          "icon": "book-open",
          "href": "https://sober.vinegarhq.org"
        }
      ]
    }
  },
  "banner": {
    "content": "LEMONYDE IS IN DEVELOPMENT SO EXPECT CHANGES! Not affiliated with Roblox Corporation or VinegarHQ.",
    "dismissible": true,
    "type": "warning"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/EpicNeco/Lemonyde",
      "discord": "https://dc.gg/lemonyde",
      "website": "https://lemonyde.netlify.app"
    },
    "links": [
      {
        "header": "Documentation",
        "items": [
          {
            "label": "Introduction",
            "href": "/index"
          },
          {
            "label": "Installation",
            "href": "/installation"
          },
          {
            "label": "Troubleshooting",
            "href": "/troubleshooting"
          }
        ]
      },
      {
        "header": "Community",
        "items": [
          {
            "label": "Discord",
            "href": "https://dc.gg/lemonyde"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/EpicNeco/Lemonyde"
          },
          {
            "label": "Issues",
            "href": "https://github.com/EpicNeco/Lemonyde/issues"
          }
        ]
      },
      {
        "header": "Related",
        "items": [
          {
            "label": "Sober by VinegarHQ",
            "href": "https://sober.vinegarhq.org"
          },
          {
            "label": "Website",
            "href": "https://lemonyde.netlify.app"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"],
    "display": "header"
  },
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Search Lemonyde docs..."
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:title": "Lemonyde — an unofficial bootstrapper for Sober",
      "og:description": "A native GTK4 control panel for Sober: install, launch, edit FastFlags, and customize Roblox on Linux.",
      "og:image": "https://repository-images.githubusercontent.com/1345827868/2aa4ecb4-ad19-4b99-b87f-11fe2da06159"
    }
  },
  "variables": {
    "sober-config": "~/.var/app/org.vinegarhq.Sober/config/sober/config.json",
    "asset-overlay": "~/.var/app/org.vinegarhq.Sober/data/sober/asset_overlay",
    "sober-package": "org.vinegarhq.Sober"
  }
}
